    "query_template": "MATCH p = (r)-[:{edges}*1..10]->(d)\nWHERE ANY(label IN labels(r) WHERE label IN {resources}) == true\n  AND ANY(label IN labels(d) WHERE label IN {demands}) == true\n  AND properties(r).version_id == {version_id}\n  AND properties(d).version_id == {version_id}\n  AND ALL(e IN relationships(p) WHERE e.version_id == {version_id}) == true\nRETURN p",
    "query_params": {
      "resource_list": [
        "monthly_resource_pool"
      ],
      "demand_list": [
        "monthly_demand_pool"
      ],
      "edge_list": [
        "rel_resource_site",
        "monthly_transport_pool",
        "rel_demand_gate_station"
      ]
    }
  },
  "business_objective": {
    "objective_type": "maximize",
    "objective_desc": "最大化利润，即销售收入减去资源采购成本、管输运力成本及资源照付不议惩罚成本",
    "objective_components": [
      {
        "component_name": "sales_revenue",
        "component_desc": "向客户销售天然气产生的收入",
        "component_type": "revenue",
        "calculation": "sum(实际供应量 * 销售单价)",
        "related_tables": [
          "monthly_demand_pool"
        ],
        "related_fields": [
          "quantity",
          "unit_selling_price"
        ],
        "is_inferred": false,
        "inference_reason": ""
      },
      {
        "component_name": "resource_cost",
        "component_desc": "采购天然气资源的成本",
        "component_type": "variable_cost",
        "calculation": "sum(实际提取量 * 采购单价)",
        "related_tables": [
          "monthly_resource_pool"
        ],
        "related_fields": [
          "quantity",
          "unit_price"
        ],
        "is_inferred": false,
        "inference_reason": ""
      },
      {
        "component_name": "transport_cost",
        "component_desc": "使用管道运输产生的运力成本",
        "component_type": "variable_cost",
        "calculation": "sum(实际运输量 * 运输单价)",
        "related_tables": [
          "monthly_transport_pool"
        ],
        "related_fields": [
          "design_gas_capacity",
          "unit_price"
        ],
        "is_inferred": false,
        "inference_reason": ""
      },
      {
        "component_name": "take_or_pay_penalty",
        "component_desc": "未满足资源合同最小提取量（照付不议）产生的惩罚成本",
        "component_type": "penalty",
        "calculation": "sum(max(0, 最小提取量 - 实际提取量) * 采购单价 * 照付不议系数)",
        "related_tables": [
          "monthly_resource_pool"
        ],
        "related_fields": [
          "min_quantity",
          "unit_price",
          "no_discuss_percent"
        ],
        "is_inferred": true,
        "inference_reason": "根据业务逻辑'资源照付不议惩罚 = 未满足最小量的部分x单价x照付不议系数'及表字段min_quantity, unit_price, no_discuss_percent推断得出"
      }
    ],
    "objective_formula": "sales_revenue - resource_cost - transport_cost - take_or_pay_penalty"
  },
  "business_constraints": {
    "constraints": [
      {
        "constraint_id": "CONST_001",
        "constraint_name": "资源供应量上限约束",
        "constraint_desc": "从每个资源提取的总量不能超过该资源的最大供应量",
        "constraint_scope": "per_resource",
        "is_hard": true,
        "related_tables": [
          "monthly_resource_pool"
        ],
        "related_fields": [
          "quantity"
        ],
        "constraint_formula": "sum(实际提取量) <= quantity"
      },
      {
        "constraint_id": "CONST_002",
        "constraint_name": "需求满足量上限约束",
        "constraint_desc": "供应给每个需求的总量不能超过该需求的最大需求量",
        "constraint_scope": "per_demand",
        "is_hard": true,
        "related_tables": [
          "monthly_demand_pool"
        ],
        "related_fields": [
          "quantity"
        ],
        "constraint_formula": "sum(实际供应量) <= quantity"
      },
      {
        "constraint_id": "CONST_003",
        "constraint_name": "管输运力上限约束",
        "constraint_desc": "每条运输路径上的流量不能超过该管段的设计输气能力",
        "constraint_scope": "per_time",
        "is_hard": true,
        "related_tables": [
          "monthly_transport_pool"
        ],
        "related_fields": [
          "design_gas_capacity"
        ],
        "constraint_formula": "sum(实际运输量) <= design_gas_capacity"
      },
      {
        "constraint_id": "CONST_004",
        "constraint_name": "门站业务能力约束",
        "constraint_desc": "经过门站的流量必须在门站的业务上下限之间",
        "constraint_scope": "per_time",
        "is_hard": true,
        "related_tables": [
          "ontology_city_gas_station_info"
        ],
        "related_fields": [
          "upper_bound",
          "lower_bound"
        ],
        "constraint_formula": "lower_bound <= sum(经过流量) <= upper_bound"
      },
      {
        "constraint_id": "CONST_005",
        "constraint_name": "管输最小量约束",
        "constraint_desc": "使用管输运力时，运输量需满足最小运输量要求（如果启用）",
        "constraint_scope": "per_time",
        "is_hard": true,
        "related_tables": [
          "monthly_transport_pool"
        ],
        "related_fields": [
          "min_amount"
        ],
        "constraint_formula": "sum(实际运输量) >= min_amount OR sum(实际运输量) = 0"
      },
      {
        "constraint_id": "CONST_006",
        "constraint_name": "需求最小满足量约束",
        "constraint_desc": "供应给每个需求的总量应尽量满足最小满足量要求",
        "constraint_scope": "per_demand",
        "is_hard": false,
        "related_tables": [
          "monthly_demand_pool"
        ],
        "related_fields": [
          "minimum_satisfy_quantity"
        ],
        "constraint_formula": "sum(实际供应量) >= minimum_satisfy_quantity"
      }
    ]
  }
}