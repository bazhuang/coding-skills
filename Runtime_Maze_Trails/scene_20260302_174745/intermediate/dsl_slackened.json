    "links": []
  },
  "decision_vars": [
    {
      "var_name": "VAR_PATH_FLOW",
      "var_type": "continuous",
      "index_sets": [
        "FEASIBLE_PATHS"
      ],
      "lower_bound": 0,
      "desc": "路径上的天然气流量"
    },
    {
      "var_name": "VAR_TAKE_OR_PAY_SHORTAGE",
      "var_type": "continuous",
      "index_sets": [
        "RESOURCE_IDS"
      ],
      "lower_bound": 0,
      "desc": "照付不议惩罚基数：资源实际提取量低于最小提取量的差额"
    },
    {
      "var_name": "VAR_resource_surplus_slack",
      "var_type": "continuous",
      "index_sets": [
        "RESOURCE_IDS"
      ],
      "lower_bound": 0,
      "desc": "【场景1-上限松弛】资源硬边界上限过剩松弛变量，代表突破供应上限的规模，非负"
    },
    {
      "var_name": "VAR_transport_surplus_slack",
      "var_type": "continuous",
      "index_sets": [
        "TRANSPORT_IDS"
      ],
      "lower_bound": 0,
      "desc": "【场景1-上限松弛】管输硬边界上限过剩松弛变量，代表突破设计运力的规模，非负"
    },
    {
      "var_name": "VAR_station_surplus_slack",
      "var_type": "continuous",
      "index_sets": [
        "STATION_IDS"
      ],
      "lower_bound": 0,
      "desc": "【场景1-上限松弛】门站硬边界上限过剩松弛变量，代表突破门站业务上限的规模，非负"
    },
    {
      "var_name": "VAR_station_slack",
      "var_type": "continuous",
      "index_sets": [
        "STATION_IDS"
      ],
      "lower_bound": 0,
      "desc": "【场景1-下限松弛】门站硬边界下限不足松弛变量，代表未达门站业务下限的缺口，非负"
    },
    {
      "var_name": "VAR_transport_min_cover_slack",
      "var_type": "continuous",
      "index_sets": [
        "TRANSPORT_IDS"
      ],
      "lower_bound": 0,
      "desc": "【场景2-最小量兜底】管输最小量达标缺口松弛变量，代表未达最小输气量的缺口，非负"
    },
    {
      "var_name": "VAR_demand_min_cover_slack",
      "var_type": "continuous",
      "index_sets": [
        "DEMAND_IDS"
      ],
      "lower_bound": 0,
      "desc": "【场景2-最小量兜底】需求最小量达标缺口松弛变量，代表未达最小需求满足量的缺口，非负"
    }
  ],
  "objective": {
    "obj_type": "maximize",
    "obj_terms": [
      {
        "term_name": "TERM_SALES_REVENUE",
        "expression": "sum(VAR_PATH_FLOW[p] * PARAM_SELLING_PRICE[p[-1]] for p in FEASIBLE_PATHS)",
        "coefficient": 1,
        "desc": "销售收入：路径流量 * 终点销售单价"
      },
      {
        "term_name": "TERM_RESOURCE_COST",
        "expression": "sum(VAR_PATH_FLOW[p] * PARAM_RESOURCE_PRICE[p[0]] for p in FEASIBLE_PATHS)",
        "coefficient": -1,
        "desc": "资源采购成本：路径流量 * 起点资源单价"
      },
      {
        "term_name": "TERM_TRANSPORT_COST",
        "expression": "sum(VAR_PATH_FLOW[p] * sum(PARAM_TRANSPORT_PRICE[e] for e in p if type(e)==int and e in TRANSPORT_IDS) for p in FEASIBLE_PATHS)",
        "coefficient": -1,
        "desc": "管输运力成本：路径流量 * 路径上所有边的管输单价之和"
      },
      {
        "term_name": "TERM_TAKE_OR_PAY_PENALTY",
        "expression": "sum(VAR_TAKE_OR_PAY_SHORTAGE[r] * PARAM_RESOURCE_PRICE[r] * PARAM_TAKE_OR_PAY_RATIO[r] for r in RESOURCE_IDS)",
        "coefficient": -1,
        "desc": "照付不议惩罚成本：辅助变量(差额) * 单价 * 系数"
      },
      {
        "term_name": "TERM_SLACK_PENALTY_RESOURCE",
        "expression": "sum(VAR_resource_surplus_slack[r] for r in RESOURCE_IDS)",
        "coefficient": -100,
        "desc": "【场景1-上限松弛】资源供应上限突破惩罚"
      },
      {
        "term_name": "TERM_SLACK_PENALTY_TRANSPORT",
        "expression": "sum(VAR_transport_surplus_slack[t] for t in TRANSPORT_IDS)",
        "coefficient": -100,
        "desc": "【场景1-上限松弛】管输运力上限突破惩罚"
      },
      {
        "term_name": "TERM_SLACK_PENALTY_STATION_UPPER",
        "expression": "sum(VAR_station_surplus_slack[s] for s in STATION_IDS)",
        "coefficient": -100,
        "desc": "【场景1-上限松弛】门站业务上限突破惩罚"
      },
      {
        "term_name": "TERM_SLACK_PENALTY_STATION_LOWER",
        "expression": "sum(VAR_station_slack[s] for s in STATION_IDS)",
        "coefficient": -100,
        "desc": "【场景1-下限松弛】门站业务下限未达惩罚"
      },
      {
        "term_name": "TERM_SLACK_PENALTY_TRANSPORT_MIN",
        "expression": "sum(VAR_transport_min_cover_slack[t] for t in TRANSPORT_IDS)",
        "coefficient": -50,
        "desc": "【场景2-最小量兜底】管输最小输气量未达惩罚"
      },
      {
        "term_name": "TERM_SLACK_PENALTY_DEMAND_MIN",
        "expression": "sum(VAR_demand_min_cover_slack[d] for d in DEMAND_IDS)",
        "coefficient": -50,
        "desc": "【场景2-最小量兜底】需求最小满足量未达惩罚"
      }
    ],
    "desc": "最大化总利润 = 销售收入 - 资源成本 - 运输成本 - 照付不议惩罚 - 松弛变量惩罚"
  },
  "constraints": [
    {
      "constraint_id": "CONST_RESOURCE_CAPACITY",
      "constraint_type": "inequality",
      "direction": "<=",
      "left_expression": "sum(VAR_PATH_FLOW[p] for p in FEASIBLE_PATHS if p[0] == r)",
      "right_expression": "PARAM_RESOURCE_CAPACITY[r] + VAR_resource_surplus_slack[r]",
      "index_sets": [
        "RESOURCE_IDS"
      ],
      "priority": 1,
      "desc": "【场景1-上限松弛】资源供应上限约束：从资源r出发的流量总和不超过资源上限+松弛"
    },
    {
      "constraint_id": "CONST_DEMAND_CAPACITY",
      "constraint_type": "inequality",
      "direction": "<=",
      "left_expression": "sum(VAR_PATH_FLOW[p] for p in FEASIBLE_PATHS if p[-1] == d)",
      "right_expression": "PARAM_DEMAND_QUANTITY[d]",
      "index_sets": [
        "DEMAND_IDS"
      ],
      "priority": 1,
      "desc": "不可软化核心约束，禁止修改：需求满足上限约束：到达需求d的流量总和不超过需求计划量"
    },
    {
      "constraint_id": "CONST_TRANSPORT_CAPACITY",
      "constraint_type": "inequality",
      "direction": "<=",
      "left_expression": "sum(VAR_PATH_FLOW[p] for p in FEASIBLE_PATHS if t in p)",
      "right_expression": "PARAM_TRANSPORT_CAPACITY[t] + VAR_transport_surplus_slack[t]",
      "index_sets": [
        "TRANSPORT_IDS"
      ],
      "priority": 1,
      "desc": "【场景1-上限松弛】管输运力上限约束：经过管道t的流量总和不超过设计能力+松弛"
    },
    {
      "constraint_id": "CONST_STATION_CAPACITY",
      "constraint_type": "inequality",
      "direction": "<=",
      "left_expression": "sum(VAR_PATH_FLOW[p] for p in FEASIBLE_PATHS if s in p)",
      "right_expression": "PARAM_STATION_UPPER_BOUND[s] + VAR_station_surplus_slack[s]",
      "index_sets": [
        "STATION_IDS"
      ],
      "priority": 1,
      "desc": "【场景1-上限松弛】门站业务上限约束：经过门站s的流量总和不超过业务上限+松弛"
    },
    {
      "constraint_id": "CONST_STATION_MIN_FLOW",
      "constraint_type": "inequality",
      "direction": ">=",
      "left_expression": "sum(VAR_PATH_FLOW[p] for p in FEASIBLE_PATHS if s in p) + VAR_station_slack[s]",
      "right_expression": "PARAM_STATION_LOWER_BOUND[s]",
      "index_sets": [
        "STATION_IDS"
      ],
      "priority": 1,
      "desc": "【场景1-下限松弛】门站业务下限约束：经过门站s的流量总和+松弛不低于业务下限"
    },
    {
      "constraint_id": "CONST_TRANSPORT_MIN_AMOUNT",
      "constraint_type": "inequality",
      "direction": ">=",
      "left_expression": "sum(VAR_PATH_FLOW[p] for p in FEASIBLE_PATHS if t in p) + VAR_transport_min_cover_slack[t]",
      "right_expression": "PARAM_TRANSPORT_MIN_AMOUNT[t]",
      "index_sets": [
        "TRANSPORT_IDS"
      ],
      "priority": 2,
      "desc": "【场景2-最小量兜底】管输最小量约束：经过管道t的流量+松弛需满足最小输气量要求"
    },
    {
      "constraint_id": "CONST_DEMAND_MIN_SATISFY",
      "constraint_type": "inequality",
      "direction": ">=",
      "left_expression": "sum(VAR_PATH_FLOW[p] for p in FEASIBLE_PATHS if p[-1] == d) + VAR_demand_min_cover_slack[d]",
      "right_expression": "PARAM_MIN_DEMAND_QTY[d]",
      "index_sets": [
        "DEMAND_IDS"
      ],
      "priority": 2,
      "relaxable": true,
      "desc": "【场景2-最小量兜底】需求最小满足量约束：到达需求d的流量+松弛需满足最小满足量"
    },
    {
      "constraint_id": "CONST_TAKE_OR_PAY_LINEARIZATION",
      "constraint_type": "inequality",
      "direction": ">=",
      "left_expression": "VAR_TAKE_OR_PAY_SHORTAGE[r] + sum(VAR_PATH_FLOW[p] for p in FEASIBLE_PATHS if p[0] == r)",
      "right_expression": "PARAM_RESOURCE_MIN_QTY[r]",
      "index_sets": [
        "RESOURCE_IDS"
      ],
      "priority": 1,
      "desc": "不可软化核心约束，禁止修改：照付不议线性化约束：辅助变量 + 实际提取量 >= 最小提取量。结合最小化目标，使辅助变量等价于 max(0, 最小提取量 - 实际提取量)"
    }
  ],
  "solve_config": {
    "solver_type": "scip",
    "solver_params": {
      "timeout": 300,
      "gap": 0.01,
      "threads": 4
    },
    "warm_start": false
  },
  "output_config": {
    "output_fields": [
      {
        "name": "path_flow",
        "expression": "VAR_PATH_FLOW",
        "desc": "路径分配流量"
      },
      {
        "name": "total_profit",
        "expression": "objective.value",
        "desc": "总利润"
      },
      {
        "name": "resource_usage",
        "expression": "sum(VAR_PATH_FLOW[p] for p in FEASIBLE_PATHS if p[0] == r)",
        "desc": "资源使用量"
      },
      {
        "name": "demand_satisfaction",
        "expression": "sum(VAR_PATH_FLOW[p] for p in FEASIBLE_PATHS if p[-1] == d)",
        "desc": "需求满足量"
      },
      {
        "name": "take_or_pay_penalty_amount",
        "expression": "VAR_TAKE_OR_PAY_SHORTAGE[r] * PARAM_RESOURCE_PRICE[r] * PARAM_TAKE_OR_PAY_RATIO[r]",
        "desc": "照付不议惩罚金额"
      }
    ],
    "output_format": "csv",
    "output_path": "./optimization_result"
  }
}