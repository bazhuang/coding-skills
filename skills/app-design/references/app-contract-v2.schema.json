{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://coding-skills/app-design/app-contract-v2.schema.json",
  "title": "App Design Contract v2",
  "description": "app-design 阶段面向现有应用、桌面端、前端和非后端目标的结构化追溯契约。",
  "type": "object",
  "required": ["version", "project", "objects", "rules", "sops"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 2
    },
    "project": {
      "type": "object",
      "required": ["targetKind", "implementation", "modules"],
      "additionalProperties": false,
      "properties": {
        "targetKind": {
          "type": "string",
          "enum": [
            "backend-java",
            "backend-python",
            "existing-app-feature",
            "desktop-electron-feature",
            "frontend-only-feature",
            "docs-or-process"
          ]
        },
        "implementation": {
          "type": "object",
          "required": ["language", "framework"],
          "additionalProperties": false,
          "properties": {
            "language": {
              "type": "string",
              "minLength": 1
            },
            "framework": {
              "type": "string",
              "minLength": 1
            },
            "guideline": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/object"
      },
      "minItems": 1
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/rule"
      }
    },
    "sops": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/sop"
      }
    }
  },
  "definitions": {
    "behaviorType": {
      "type": "string",
      "enum": ["CREATE", "UPDATE", "QUERY", "DELETE", "DERIVE"]
    },
    "persistence": {
      "type": "string",
      "enum": [
        "mysql-table",
        "postgres-table",
        "sqlite-table",
        "sqlite-kv-existing",
        "existing-local-kv",
        "external-service",
        "transient-memory",
        "ui-state",
        "none"
      ]
    },
    "object": {
      "type": "object",
      "required": ["code", "name", "persistence", "behaviors"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]*$"
        },
        "table": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "persistence": {
          "$ref": "#/definitions/persistence"
        },
        "persistenceReason": {
          "type": "string",
          "minLength": 1
        },
        "behaviors": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/behavior"
          },
          "minItems": 1
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^F-\\d{3,}$"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "persistence": {
                "enum": ["mysql-table", "postgres-table", "sqlite-table"]
              }
            },
            "required": ["persistence"]
          },
          "then": {
            "required": ["table"]
          }
        }
      ]
    },
    "behavior": {
      "type": "object",
      "required": ["type", "surfaces"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/definitions/behaviorType"
        },
        "surfaces": {
          "$ref": "#/definitions/surfaces"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "surfaces": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        ]
      },
      "properties": {
        "component": {
          "$ref": "#/definitions/surfaceValue"
        },
        "renderer": {
          "$ref": "#/definitions/surfaceValue"
        },
        "preload": {
          "$ref": "#/definitions/surfaceValue"
        },
        "ipc": {
          "$ref": "#/definitions/surfaceValue"
        },
        "main": {
          "$ref": "#/definitions/surfaceValue"
        },
        "external": {
          "$ref": "#/definitions/surfaceValue"
        },
        "route": {
          "$ref": "#/definitions/surfaceValue"
        },
        "store": {
          "$ref": "#/definitions/surfaceValue"
        },
        "api": {
          "$ref": "#/definitions/surfaceValue"
        },
        "service": {
          "$ref": "#/definitions/surfaceValue"
        }
      }
    },
    "surfaceValue": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      ]
    },
    "rule": {
      "type": "object",
      "required": ["code", "source", "type", "location"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
        },
        "source": {
          "type": "string",
          "enum": ["ontology", "design"]
        },
        "type": {
          "type": "string",
          "enum": ["CALCULATION", "CONSTRAINT", "CROSS_ENTITY"]
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      }
    },
    "sop": {
      "type": "object",
      "required": ["code", "entry", "calls"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
        },
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "calls": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
