{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "business-to-or-ontology/or_ontology.schema.json",
  "title": "or_ontology",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "problem_frame",
    "algorithm_objects",
    "objective_system",
    "constraint_system",
    "mapping_rationale",
    "open_questions"
  ],
  "properties": {
    "problem_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem_type",
        "optimization_goal",
        "time_granularity",
        "business_scope"
      ],
      "properties": {
        "problem_type": {
          "type": "string"
        },
        "optimization_goal": {
          "type": "string"
        },
        "time_granularity": {
          "type": "string",
          "description": "明确的规划/匹配时间粒度，例如年度、季度、月度、周度、日度、小时级或输入中明确命名的业务粒度。无法确定时应抛出阻断性 open_questions。"
        },
        "business_scope": {
          "type": "string"
        }
      }
    },
    "algorithm_objects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objects"
      ],
      "properties": {
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/algorithmObject"
          }
        }
      }
    },
    "objective_system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective_type",
        "objective_terms",
        "objective_aggregation"
      ],
      "properties": {
        "objective_type": {
          "type": "string",
          "enum": [
            "maximize",
            "minimize",
            "balance",
            "satisfy_priority"
          ]
        },
        "objective_terms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/objectiveTerm"
          }
        },
        "objective_aggregation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary_name",
            "business_meaning",
            "expression",
            "expression_style",
            "includes_terms"
          ],
          "properties": {
            "summary_name": {
              "type": "string"
            },
            "business_meaning": {
              "type": "string"
            },
            "expression": {
              "type": "string"
            },
            "expression_style": {
              "type": "string",
              "enum": [
                "natural_language",
                "natural_language_with_symbols"
              ]
            },
            "includes_terms": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "constraint_system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraints"
      ],
      "properties": {
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constraintItem"
          }
        }
      }
    },
    "mapping_rationale": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/openQuestion"
      }
    }
  },
  "$defs": {
    "dataTable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table_name",
        "table_desc",
        "fields",
        "primary_key"
      ],
      "properties": {
        "table_name": {
          "type": "string"
        },
        "table_desc": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dataField"
          }
        },
        "primary_key": {
          "description": "来源表的主键字段列表，按 simulation_schema 原始定义保留。",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unique_keys": {
          "description": "来源表中可稳定识别的唯一键字段组合，按 simulation_schema 原始定义保留字段列表。",
          "type": "array",
          "items": {
            "$ref": "#/$defs/uniqueKey"
          }
        },
        "foreign_keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/foreignKey"
          }
        },
        "time_field": {
          "type": "string"
        }
      }
    },
    "dataField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "desc",
        "is_required"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "desc": {
          "type": "string"
        },
        "is_required": {
          "type": "boolean"
        },
        "default_value": {},
        "constraints": {
          "type": "string"
        }
      }
    },
    "uniqueKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields"
      ],
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "foreignKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields",
        "ref_table",
        "ref_fields"
      ],
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "ref_table": {
          "type": "string"
        },
        "ref_fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "algorithmObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_name",
        "object_category",
        "object_type",
        "source_business_entities",
        "grain",
        "business_role",
        "data_support"
      ],
      "properties": {
        "object_name": {
          "type": "string"
        },
        "object_category": {
          "type": "string",
          "enum": [
            "resource",
            "node",
            "edge"
          ]
        },
        "object_type": {
          "type": "string",
          "enum": [
            "resource",
            "supply_node",
            "demand_node",
            "passthrough_node",
            "processor_node",
            "storage_node",
            "transport",
            "link"
          ]
        },
        "source_business_entities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "schema_binding_status": {
          "type": "string",
          "enum": [
            "not_applicable",
            "attached",
            "referenced",
            "missing"
          ]
        },
        "supporting_tables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supporting_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "grain": {
          "type": "string"
        },
        "business_role": {
          "type": "string"
        },
        "edge_endpoints": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "from_objects": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "to_objects": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "supporting_fields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "data_support": {
          "type": "string",
          "enum": [
            "full",
            "partial",
            "missing",
            "unknown"
          ]
        },
        "table_schema": {
          "$ref": "#/$defs/dataTable"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "object_category": {
                "const": "resource"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "table_schema"
              ]
            },
            "properties": {
              "schema_binding_status": {
                "const": "not_applicable"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "object_category": {
                "const": "resource"
              }
            },
            "required": [
              "object_category"
            ]
          },
          "then": {
            "properties": {
              "object_type": {
                "const": "resource"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "object_category": {
                "const": "node"
              }
            },
            "required": [
              "object_category"
            ]
          },
          "then": {
            "properties": {
              "object_type": {
                "enum": [
                  "supply_node",
                  "demand_node",
                  "passthrough_node",
                  "processor_node",
                  "storage_node"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "object_category": {
                "const": "edge"
              }
            },
            "required": [
              "object_category"
            ]
          },
          "then": {
            "properties": {
              "object_type": {
                "enum": [
                  "transport",
                  "link"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "object_category": {
                "const": "edge"
              }
            }
          },
          "then": {
            "required": [
              "edge_endpoints"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "object_category": {
                "enum": [
                  "node",
                  "edge"
                ]
              }
            },
            "required": [
              "object_category"
            ]
          },
          "then": {
            "required": [
              "schema_binding_status"
            ],
            "properties": {
              "schema_binding_status": {
                "enum": [
                  "attached",
                  "referenced",
                  "missing"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "schema_binding_status": {
                "const": "attached"
              }
            },
            "required": [
              "schema_binding_status"
            ]
          },
          "then": {
            "required": [
              "table_schema"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "schema_binding_status": {
                "const": "referenced"
              }
            },
            "required": [
              "schema_binding_status"
            ]
          },
          "then": {
            "required": [
              "supporting_tables"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "schema_binding_status": {
                "const": "missing"
              }
            },
            "required": [
              "schema_binding_status"
            ]
          },
          "then": {
            "properties": {
              "data_support": {
                "enum": [
                  "partial",
                  "missing",
                  "unknown"
                ]
              }
            }
          }
        }
      ]
    },
    "objectiveTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "business_meaning",
        "expression",
        "expression_style",
        "related_tables",
        "related_fields",
        "is_inferred"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "business_meaning": {
          "type": "string"
        },
        "expression": {
          "type": "string"
        },
        "expression_style": {
          "type": "string",
          "enum": [
            "natural_language",
            "natural_language_with_symbols"
          ]
        },
        "related_tables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "related_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "is_inferred": {
          "type": "boolean"
        },
        "inference_basis": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "constraintItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "constraint_category",
        "business_meaning",
        "expression",
        "expression_style",
        "confidence",
        "related_tables",
        "related_fields",
        "data_support"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "constraint_category": {
          "type": "string",
          "enum": [
            "supply_limit",
            "demand_service",
            "transport_limit",
            "processing_limit",
            "inventory_limit",
            "time_rule",
            "conversion_rule",
            "routing_rule",
            "matching_rule",
            "priority_rule",
            "other"
          ]
        },
        "business_meaning": {
          "type": "string"
        },
        "expression": {
          "type": "string"
        },
        "expression_style": {
          "type": "string",
          "enum": [
            "natural_language",
            "natural_language_with_symbols"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "related_tables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "related_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data_support": {
          "type": "string",
          "enum": [
            "full",
            "partial",
            "missing",
            "unknown"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "openQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question"
      ],
      "properties": {
        "question": {
          "type": "string"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "impact": {
          "type": "string"
        }
      }
    }
  }
}
