{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "business-to-or-ontology/ontology-mapping.schema.json",
  "title": "Business To OR Normalization Trace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "business_entities",
    "entity_mappings",
    "objective_items",
    "constraint_items",
    "data_evidence",
    "mapping_rationale",
    "open_questions"
  ],
  "properties": {
    "business_entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity_name",
          "source_fragments",
          "business_role"
        ],
        "properties": {
          "entity_name": {
            "type": "string"
          },
          "source_fragments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "business_role": {
            "type": "string"
          },
          "supporting_tables": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "supporting_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "entity_mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_entity",
          "object_category",
          "object_type",
          "normalized_name",
          "grain",
          "key_fields",
          "business_role",
          "mapping_basis",
          "data_support"
        ],
        "properties": {
          "source_entity": {
            "type": "string"
          },
          "object_category": {
            "type": "string",
            "enum": [
              "resource",
              "node",
              "edge"
            ]
          },
          "object_type": {
            "type": "string",
            "enum": [
              "resource",
              "supply_node",
              "demand_node",
              "passthrough_node",
              "processor_node",
              "storage_node",
              "transport",
              "link"
            ]
          },
          "normalized_name": {
            "type": "string"
          },
          "grain": {
            "type": "string"
          },
          "key_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "business_role": {
            "type": "string"
          },
          "supporting_tables": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "supporting_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mapping_basis": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "data_support": {
            "type": "string",
            "enum": [
              "full",
              "partial",
              "missing",
              "unknown"
            ]
          }
        }
      }
    },
    "objective_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_goal",
          "normalized_goal",
          "business_meaning",
          "expression",
          "expression_style",
          "related_tables",
          "related_fields",
          "is_inferred"
        ],
        "properties": {
          "source_goal": {
            "type": "string"
          },
          "normalized_goal": {
            "type": "string"
          },
          "business_meaning": {
            "type": "string"
          },
          "expression": {
            "type": "string"
          },
          "expression_style": {
            "type": "string",
            "enum": [
              "natural_language",
              "natural_language_with_symbols"
            ]
          },
          "related_tables": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "related_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "is_inferred": {
            "type": "boolean"
          },
          "inference_basis": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      }
    },
    "constraint_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_rule",
          "normalized_constraint",
          "constraint_category",
          "business_meaning",
          "expression",
          "expression_style",
          "confidence",
          "related_tables",
          "related_fields",
          "data_support"
        ],
        "properties": {
          "source_rule": {
            "type": "string"
          },
          "normalized_constraint": {
            "type": "string"
          },
          "constraint_category": {
            "type": "string",
            "enum": [
              "supply_limit",
              "demand_service",
              "transport_limit",
              "processing_limit",
              "inventory_limit",
              "time_rule",
              "conversion_rule",
              "routing_rule",
              "matching_rule",
              "priority_rule",
              "other"
            ]
          },
          "business_meaning": {
            "type": "string"
          },
          "expression": {
            "type": "string"
          },
          "expression_style": {
            "type": "string",
            "enum": [
              "natural_language",
              "natural_language_with_symbols"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "related_tables": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "related_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "data_support": {
            "type": "string",
            "enum": [
              "full",
              "partial",
              "missing",
              "unknown"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "data_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_name",
          "selected_tables",
          "selected_fields",
          "evidence_notes"
        ],
        "properties": {
          "target_name": {
            "type": "string"
          },
          "selected_tables": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "selected_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "mapping_rationale": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/openQuestion"
      }
    }
  },
  "$defs": {
    "openQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question"
      ],
      "properties": {
        "question": {
          "type": "string"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "impact": {
          "type": "string"
        }
      }
    }
  }
}
