{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runtime_package_manifest.schema.json",
  "title": "OR Runtime Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entrypoint",
    "runtime_input",
    "run_command",
    "files",
    "config_paths",
    "source_artifacts",
    "validation_results"
  ],
  "properties": {
    "entrypoint": { "const": "main.py" },
    "runtime_input": { "const": "version_id" },
    "run_command": { "const": "python main.py --version-id <version_id>" },
    "files": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/fileRecord" }
    },
    "config_paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mysql", "nebula"],
      "properties": {
        "mysql": { "const": "db/config/mysql_config.json" },
        "nebula": { "const": "db/config/nebula_config.json" },
        "graph_path_queries": { "const": "graph_path_queries.json" }
      }
    },
    "source_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_loader_code_bundle",
        "core_code_bundle",
        "or_dsl_safeguarded"
      ],
      "properties": {
        "data_loader_code_bundle": { "$ref": "#/$defs/sourceArtifact" },
        "core_code_bundle": { "$ref": "#/$defs/sourceArtifact" },
        "or_dsl_safeguarded": { "$ref": "#/$defs/sourceArtifact" },
        "graph_path_queries": { "$ref": "#/$defs/sourceArtifact" }
      }
    },
    "validation_results": {
      "type": "object",
      "additionalProperties": false,
      "required": ["syntax_check", "interface_check", "boundary_check"],
      "properties": {
        "syntax_check": { "$ref": "#/$defs/validationRecord" },
        "interface_check": { "$ref": "#/$defs/validationRecord" },
        "boundary_check": { "$ref": "#/$defs/validationRecord" }
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "fileRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "responsibility", "public_interfaces", "depends_on"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "responsibility": { "type": "string", "minLength": 1 },
        "public_interfaces": {
          "type": "array",
          "items": { "type": "string" }
        },
        "depends_on": {
          "type": "array",
          "items": { "type": "string" }
        },
        "source_artifact": { "type": "string" }
      }
    },
    "sourceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "path": { "type": "string" },
        "content_hash": { "type": "string" }
      }
    },
    "validationRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "messages"],
      "properties": {
        "status": { "enum": ["passed", "failed", "not_run"] },
        "messages": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
