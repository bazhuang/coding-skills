{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "or-spatial-path-query/graph_path_queries.schema.json",
  "title": "graph_path_queries",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query_language",
    "version_id_placeholder",
    "path_queries",
    "unresolved_gaps"
  ],
  "properties": {
    "query_language": {
      "type": "string",
      "enum": [ "cypher", "openCypher", "nGQL", "other" ]
    },
    "version_id_placeholder": {
      "type": "string",
      "const": "{version_id}"
    },
    "path_queries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/pathQuery" }
    },
    "unresolved_gaps": {
      "type": "array",
      "items": { "$ref": "#/$defs/unresolvedGap" }
    }
  },
  "$defs": {
    "pathQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_name",
        "path_parameters",
        "version_filtering",
        "query_template"
      ],
      "properties": {
        "query_name": { "type": "string" },
        "path_parameters": { "$ref": "#/$defs/pathParameters" },
        "version_filtering": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "placeholder",
            "start_node_filter",
            "end_node_filter",
            "edge_filter"
          ],
          "properties": {
            "placeholder": {
              "type": "string",
              "const": "{version_id}"
            },
            "start_node_filter": { "type": "string" },
            "end_node_filter": { "type": "string" },
            "edge_filter": { "type": "string" }
          }
        },
        "query_template": {
          "type": "string",
          "pattern": "\\{version_id\\}"
        },
        "notes": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string",
            "maxLength": 160
          }
        }
      }
    },
    "pathParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "start_nodes", "end_nodes", "path_edges" ],
      "properties": {
        "start_nodes": { "$ref": "#/$defs/pathParameter" },
        "end_nodes": { "$ref": "#/$defs/pathParameter" },
        "path_edges": { "$ref": "#/$defs/pathParameter" }
      }
    },
    "pathParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "graph_type", "values" ],
      "properties": {
        "graph_type": {
          "type": "string",
          "enum": [ "tag", "edge" ]
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "version_filter": { "type": "string" },
        "notes": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "string",
            "maxLength": 120
          }
        }
      }
    },
    "unresolvedGap": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "gap", "impact" ],
      "properties": {
        "gap": { "type": "string" },
        "impact": { "type": "string" },
        "note": {
          "type": "string",
          "maxLength": 160
        }
      }
    }
  }
}
