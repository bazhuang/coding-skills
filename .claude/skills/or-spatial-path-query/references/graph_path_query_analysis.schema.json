{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "or-spatial-path-query/graph_path_query_analysis.schema.json",
  "title": "Graph Path Query Analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "network_role_mapping",
    "graph_sql_evidence",
    "path_query_candidates",
    "unresolved_gaps"
  ],
  "properties": {
    "network_role_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "supply_nodes", "demand_nodes", "path_edges" ],
      "properties": {
        "supply_nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/nodeMapping" }
        },
        "demand_nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/nodeMapping" }
        },
        "path_edges": {
          "type": "array",
          "items": { "$ref": "#/$defs/edgeMapping" }
        }
      }
    },
    "graph_sql_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "table_type_evidence", "node_labels", "edge_types", "version_id_evidence" ],
      "properties": {
        "table_type_evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/tableTypeEvidence" }
        },
        "node_labels": {
          "type": "array",
          "items": { "$ref": "#/$defs/labelEvidence" }
        },
        "edge_types": {
          "type": "array",
          "items": { "$ref": "#/$defs/edgeEvidence" }
        },
        "version_id_evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/versionEvidence" }
        },
        "hop_range_evidence": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "path_query_candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/pathQueryCandidate" }
    },
    "unresolved_gaps": {
      "type": "array",
      "items": { "$ref": "#/$defs/unresolvedGap" }
    }
  },
  "$defs": {
    "nodeMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "graph_table_type", "candidate_labels", "mapping_basis", "confidence" ],
      "properties": {
        "graph_table_type": {
          "type": "string",
          "enum": [ "supply_node", "demand_node" ]
        },
        "candidate_labels": {
          "type": "array",
          "items": { "type": "string" }
        },
        "property_scope": { "type": "string" },
        "version_id_property_path": { "type": "string" },
        "mapping_basis": {
          "type": "array",
          "items": { "type": "string" }
        },
        "confidence": {
          "type": "string",
          "enum": [ "high", "medium", "low" ]
        }
      }
    },
    "edgeMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "graph_table_type", "candidate_edge_types", "mapping_basis", "confidence" ],
      "properties": {
        "graph_table_type": {
          "type": "string",
          "enum": [ "transport", "link" ]
        },
        "candidate_edge_types": {
          "type": "array",
          "items": { "type": "string" }
        },
        "version_id_property_path": { "type": "string" },
        "mapping_basis": {
          "type": "array",
          "items": { "type": "string" }
        },
        "confidence": {
          "type": "string",
          "enum": [ "high", "medium", "low" ]
        }
      }
    },
    "tableTypeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "object_kind", "name", "table_type", "evidence" ],
      "properties": {
        "object_kind": {
          "type": "string",
          "enum": [ "tag", "edge" ]
        },
        "name": { "type": "string" },
        "table_type": {
          "type": "string",
          "enum": [
            "supply_node",
            "demand_node",
            "passthrough_node",
            "processor_node",
            "storage_node",
            "transport",
            "link",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "labelEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "label", "evidence" ],
      "properties": {
        "label": { "type": "string" },
        "source_table_or_object": { "type": "string" },
        "evidence": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "edgeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "edge_type", "evidence" ],
      "properties": {
        "edge_type": { "type": "string" },
        "source_table_or_object": { "type": "string" },
        "evidence": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "versionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "scope", "property_path", "evidence" ],
      "properties": {
        "scope": {
          "type": "string",
          "enum": [ "start_node", "end_node", "edge", "unknown" ]
        },
        "property_path": { "type": "string" },
        "evidence": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "pathQueryCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_name",
        "start_node_labels",
        "end_node_labels",
        "edge_types",
        "min_hops",
        "version_id_placeholder",
        "derivation_basis",
        "confidence"
      ],
      "properties": {
        "query_name": { "type": "string" },
        "business_meaning": { "type": "string" },
        "start_node_labels": {
          "type": "array",
          "items": { "type": "string" }
        },
        "end_node_labels": {
          "type": "array",
          "items": { "type": "string" }
        },
        "edge_types": {
          "type": "array",
          "items": { "type": "string" }
        },
        "min_hops": {
          "type": "integer",
          "minimum": 0
        },
        "max_hops": {
          "type": "integer",
          "minimum": 1
        },
        "version_id_placeholder": {
          "type": "string",
          "const": "{version_id}"
        },
        "derivation_basis": {
          "type": "array",
          "items": { "type": "string" }
        },
        "confidence": {
          "type": "string",
          "enum": [ "high", "medium", "low" ]
        }
      }
    },
    "unresolvedGap": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "gap", "impact" ],
      "properties": {
        "gap": { "type": "string" },
        "impact": { "type": "string" },
        "evidence": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
