{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "or-ontology-spatial-path-query-embedding/algorithm_ontology_path_query_embedded.schema.json",
  "title": "or_ont_path_query_embedded",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "problem_frame",
    "algorithm_objects",
    "objective_system",
    "constraint_system",
    "graph_path_query_system",
    "mapping_rationale",
    "open_questions"
  ],
  "properties": {
    "problem_frame": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "problem_type",
        "optimization_goal",
        "time_granularity",
        "business_scope"
      ],
      "properties": {
        "problem_type": { "type": "string" },
        "optimization_goal": { "type": "string" },
        "time_granularity": { "type": "string" },
        "business_scope": { "type": "string" }
      }
    },
    "algorithm_objects": {
      "type": "object",
      "additionalProperties": true,
      "required": [ "objects" ],
      "properties": {
        "objects": {
          "type": "array",
          "items": { "$ref": "#/$defs/algorithmObject" }
        }
      }
    },
    "objective_system": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "objective_type",
        "objective_terms",
        "objective_aggregation"
      ],
      "properties": {
        "objective_type": { "type": "string" },
        "objective_terms": {
          "type": "array",
          "items": { "type": "object" }
        },
        "objective_aggregation": { "type": "object" }
      }
    },
    "constraint_system": {
      "type": "object",
      "additionalProperties": true,
      "required": [ "constraints" ],
      "properties": {
        "constraints": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    },
    "graph_path_query_system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_language",
        "version_id_placeholder",
        "path_queries",
        "unresolved_gaps"
      ],
      "properties": {
        "query_language": {
          "type": "string",
          "enum": [ "cypher", "openCypher", "nGQL", "other" ]
        },
        "version_id_placeholder": {
          "type": "string",
          "const": "{version_id}"
        },
        "path_queries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/pathQuery" }
        },
        "unresolved_gaps": {
          "type": "array",
          "items": { "$ref": "#/$defs/unresolvedGap" }
        }
      }
    },
    "mapping_rationale": {
      "type": "array",
      "items": { "type": "string" }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "object" }
    }
  },
  "$defs": {
    "algorithmObject": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "object_name",
        "object_category",
        "object_type",
        "grain",
        "business_role",
        "data_support"
      ],
      "properties": {
        "object_name": { "type": "string" },
        "object_category": {
          "type": "string",
          "enum": [ "resource", "node", "edge" ]
        },
        "object_type": {
          "type": "string",
          "enum": [
            "resource",
            "supply_node",
            "demand_node",
            "passthrough_node",
            "processor_node",
            "storage_node",
            "transport",
            "link"
          ]
        },
        "grain": { "type": "string" },
        "business_role": { "type": "string" },
        "data_support": {
          "type": "string",
          "enum": [ "full", "partial", "missing", "unknown" ]
        }
      }
    },
    "pathQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_name",
        "path_parameters",
        "version_filtering",
        "query_template"
      ],
      "properties": {
        "query_name": { "type": "string" },
        "path_parameters": { "$ref": "#/$defs/pathParameters" },
        "version_filtering": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "placeholder",
            "start_node_filter",
            "end_node_filter",
            "edge_filter"
          ],
          "properties": {
            "placeholder": {
              "type": "string",
              "const": "{version_id}"
            },
            "start_node_filter": { "type": "string" },
            "end_node_filter": { "type": "string" },
            "edge_filter": { "type": "string" }
          }
        },
        "query_template": {
          "type": "string",
          "pattern": "\\{version_id\\}"
        },
        "notes": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string",
            "maxLength": 160
          }
        }
      }
    },
    "pathParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "start_nodes", "end_nodes", "path_edges" ],
      "properties": {
        "start_nodes": { "$ref": "#/$defs/pathParameter" },
        "end_nodes": { "$ref": "#/$defs/pathParameter" },
        "path_edges": { "$ref": "#/$defs/pathParameter" }
      }
    },
    "pathParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "graph_type", "values" ],
      "properties": {
        "graph_type": {
          "type": "string",
          "enum": [ "tag", "edge" ]
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "version_filter": { "type": "string" },
        "notes": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "string",
            "maxLength": 120
          }
        }
      }
    },
    "unresolvedGap": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "gap", "impact" ],
      "properties": {
        "gap": { "type": "string" },
        "impact": { "type": "string" },
        "note": {
          "type": "string",
          "maxLength": 160
        }
      }
    }
  }
}
