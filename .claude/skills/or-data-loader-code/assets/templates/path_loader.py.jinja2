        sequence.append(_node_key(node))
        if index < len(edges):
            sequence.append(_edge_key(edges[index]))
    validate_path_sequence(sequence)
    return sequence


def validate_path_sequence(sequence: list[Any]) -> None:
    if len(sequence) < 3:
        raise ValueError("Path sequence length must be at least 3.")
    if len(sequence) % 2 == 0:
        raise ValueError("Path sequence length must be odd.")


