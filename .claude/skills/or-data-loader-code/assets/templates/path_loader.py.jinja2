    def connect(self) -> None:
        pool_config = self.config.get("pool_config", {})
        nebula_config = NebulaConfig()
        if "max_size" in pool_config:
            nebula_config.max_connection_pool_size = int(pool_config["max_size"])
        if "timeout" in pool_config:
            nebula_config.timeout = int(pool_config["timeout"])

        endpoints = [(item["host"], int(item["port"])) for item in self.config["cluster_servers"]]
        self.connection_pool = ConnectionPool()
