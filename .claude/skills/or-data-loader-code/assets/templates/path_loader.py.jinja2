def _load_json_file(path: str | Path) -> dict[str, Any]:
    with Path(path).open("r", encoding="utf-8") as f:
        data = json.load(f)
    if not isinstance(data, dict):
        raise ValueError(f"JSON file must contain an object: {path}")
    return data


def _validate_nebula_config(config: dict[str, Any]) -> None:
    missing = [field for field in REQUIRED_NEBULA_CONFIG_FIELDS if field not in config]
    if missing:
        raise ValueError(f"NebulaGraph config missing required fields: {missing}")
    if not isinstance(config["cluster_servers"], list) or not config["cluster_servers"]:
        raise ValueError("NebulaGraph config cluster_servers must be a non-empty list.")


def _validate_query_config(query_config: dict[str, Any]) -> None:
    if query_config.get("version_id_placeholder") != "{version_id}":
        raise ValueError("graph_path_queries version_id_placeholder must be '{version_id}'.")
    path_queries = query_config.get("path_queries")
    if not isinstance(path_queries, list) or not path_queries:
        raise ValueError("graph_path_queries must contain at least one path_queries item.")
    for item in path_queries:
        template = item.get("query_template", "")
        if "{version_id}" not in template:
            name = item.get("query_name", "<unnamed>")
            raise ValueError(f"path query {name} is missing '{{version_id}}' in query_template.")


def _format_version_id(version_id: str) -> str:
    return json.dumps(str(version_id), ensure_ascii=False)


def _extract_value(value: Any) -> Any:
    if value is None:
        return None
    for flag_name, getter_name in (
        ("is_string", "as_string"),
        ("is_int", "as_int"),
        ("is_double", "as_double"),
        ("is_bool", "as_bool"),
        ("is_datetime", "as_datetime"),
    ):
        flag = getattr(value, flag_name, None)
        getter = getattr(value, getter_name, None)
        if callable(flag) and flag() and callable(getter):
            return getter()
    return value


def _node_key(node: Any) -> Any:
    tags = list(node.tags())
    for tag in tags:
        pk_field = PRIMARY_KEY_MAPPING.get(tag)
        if pk_field:
            raw_value = node.properties().get(pk_field)
            if raw_value is None:
                raise ValueError(f"Node tag {tag} missing primary-key field {pk_field}.")
            return _extract_value(raw_value)
    node_id = node.get_id()
    return _extract_value(node_id) if node_id is not None else node_id


def _edge_key(edge: Any) -> Any:
    edge_type = edge.edge_name()
    pk_field = PRIMARY_KEY_MAPPING.get(edge_type)
    if pk_field:
        raw_value = edge.properties().get(pk_field)
        if raw_value is None:
            raise ValueError(f"Edge type {edge_type} missing primary-key field {pk_field}.")
        return _extract_value(raw_value)
    rank = edge.ranking() if hasattr(edge, "ranking") else None
    return rank if rank is not None else edge_type


def parse_path(path_data: Any) -> list[Any]:
    nodes = list(path_data.nodes())
    edges = list(path_data.relationships())
    if len(nodes) != len(edges) + 1:
        raise ValueError("Invalid path shape: expected one more node than edge.")

    sequence: list[Any] = []
