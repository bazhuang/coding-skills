"""
Runtime data loader that composes MySQL table loading and NebulaGraph path loading.

Generated at: {{ generation_time | default("unknown") }}
"""

from __future__ import annotations

from pathlib import Path
from typing import Any

from path_loader import PathLoader
from table_loader import TableLoader


DEFAULT_MYSQL_CONFIG_PATH = Path("db/config/mysql_config.json")
DEFAULT_NEBULA_CONFIG_PATH = Path("db/config/nebula_config.json")


class DataLoader:
    def __init__(
        self,
        graph_path_queries_path: str | Path,
        mysql_config_path: str | Path = DEFAULT_MYSQL_CONFIG_PATH,
        nebula_config_path: str | Path = DEFAULT_NEBULA_CONFIG_PATH,
    ):
        self.table_loader = TableLoader(config_path=mysql_config_path)
        self.path_loader = PathLoader(
            config_path=nebula_config_path,
            query_config_path=graph_path_queries_path,
        )

    def connect(self) -> None:
        self.table_loader.connect()
        self.path_loader.connect()

    def close(self) -> None:
        self.table_loader.close()
        self.path_loader.close()

    def load_all(self, version_id: str) -> dict[str, Any]:
        if not version_id:
            raise ValueError("version_id is required.")
        return {
            "tables": self.table_loader.load_all(version_id),
            "paths": self.path_loader.load_paths(version_id),
        }
