{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artifact_metadata.schema.json",
  "title": "Main Agent Artifact Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "path",
    "status",
    "content_hash",
    "producer",
    "consumers",
    "input_hashes",
    "stale"
  ],
  "properties": {
    "name": { "type": "string" },
    "path": { "type": "string" },
    "status": { "enum": ["available", "missing"] },
    "content_hash": {
      "anyOf": [
        { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        { "type": "null" }
      ]
    },
    "producer": {
      "anyOf": [
        { "type": "string" },
        { "type": "null" }
      ]
    },
    "schema_path": {
      "anyOf": [
        { "type": "string" },
        { "type": "null" }
      ]
    },
    "consumers": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "input_hashes": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          { "type": "null" }
        ]
      }
    },
    "stale": { "type": "boolean" },
    "stale_reasons": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    }
  }
}
