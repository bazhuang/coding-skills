{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenario_profile.schema.json",
  "title": "OR Main Agent Scenario Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "has_time_dimension",
    "has_spatial_network",
    "requires_graph_modeling",
    "requires_path_query",
    "modeling_style",
    "data_sources",
    "runtime_entry",
    "blocking_gaps"
  ],
  "properties": {
    "has_time_dimension": { "type": "boolean" },
    "has_spatial_network": { "type": "boolean" },
    "requires_graph_modeling": { "type": "boolean" },
    "requires_path_query": { "type": "boolean" },
    "modeling_style": {
      "type": "string",
      "enum": [
        "linear_table_model",
        "time_indexed_model",
        "network_flow",
        "path_flow",
        "spatiotemporal_path_flow",
        "mixed"
      ]
    },
    "data_sources": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["mysql", "nebula", "csv", "api", "other"]
      },
      "uniqueItems": true
    },
    "runtime_entry": { "const": "version_id" },
    "blocking_gaps": {
      "type": "array",
      "items": { "$ref": "#/$defs/gap" }
    },
    "degraded_gaps": {
      "type": "array",
      "items": { "$ref": "#/$defs/gap" },
      "default": []
    },
    "informational_gaps": {
      "type": "array",
      "items": { "$ref": "#/$defs/gap" },
      "default": []
    },
    "routing_notes": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    }
  },
  "$defs": {
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "affected_artifacts": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "recommended_action": { "type": "string" }
      }
    }
  }
}
