{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gate_results.schema.json",
  "title": "OR Main Agent Gate Results",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_dir", "generated_at", "passed", "results"],
  "properties": {
    "run_dir": { "type": "string" },
    "generated_at": { "type": "string" },
    "passed": { "type": "boolean" },
    "results": {
      "type": "array",
      "items": { "$ref": "#/$defs/gateResult" }
    }
  },
  "$defs": {
    "gateResult": {
      "type": "object",
      "additionalProperties": true,
      "required": ["gate", "passed", "checks"],
      "properties": {
        "gate": {
          "type": "string",
          "enum": ["schema_gate", "semantic_gate", "boundary_gate"]
        },
        "passed": { "type": "boolean" },
        "checks": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    }
  }
}
