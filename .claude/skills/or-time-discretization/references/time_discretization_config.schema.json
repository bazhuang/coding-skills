{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "time_discretization_config.schema.json",
  "title": "Time Discretization Configuration",
  "description": "时间离散化配置，从 or_ontology 中提取含 time_dimension 的对象后生成，校验通过后用于生成数据管线代码和 DDL",
  "type": "object",
  "additionalProperties": false,
  "required": ["objects"],
  "properties": {
    "objects": {
      "type": "array",
      "description": "含时间维度的对象列表",
      "minItems": 1,
      "items": { "$ref": "#/$defs/timeObject" }
    }
  },
  "$defs": {
    "timeObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_name",
        "object_category",
        "table_name",
        "start_time_field",
        "end_time_field",
        "time_interval",
        "quantity_fields",
        "discretized_table"
      ],
      "properties": {
        "object_name": {
          "type": "string",
          "description": "对象名称，来源于 or_ontology 中对象的 name 字段",
          "minLength": 1
        },
        "object_category": {
          "type": "string",
          "enum": ["node", "edge"],
          "description": "对象类别：node 或 edge"
        },
        "table_name": {
          "type": "string",
          "description": "表名，来源于 object.table_schema.table_name",
          "minLength": 1
        },
        "start_time_field": {
          "type": "string",
          "description": "开始时间字段名，必须能在 table_schema.fields 中找到对应定义",
          "minLength": 1
        },
        "end_time_field": {
          "type": "string",
          "description": "结束时间字段名，必须能在 table_schema.fields 中找到对应定义",
          "minLength": 1
        },
        "time_interval": {
          "type": "string",
          "enum": ["Y", "Q", "M", "W", "D"],
          "description": "时间间隔单位"
        },
        "quantity_fields": {
          "type": "array",
          "description": "需要拆分的量字段列表，不能为空，每个字段必须是数值类型（int/int64/double）",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "discretized_table": {
          "type": "string",
          "description": "拆分结果表名，格式为 discretized_{table_name}，不能与 or_ontology 中任何现有表名冲突",
          "minLength": 1
        }
      }
    }
  }
}
