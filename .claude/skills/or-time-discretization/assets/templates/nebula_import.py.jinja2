"""
NebulaGraph 数据导入脚本

将 MySQL 查询结果导入到 NebulaGraph 图数据库。
TAG/EDGE 列表和字段映射从 or_ontology 中提取。
此文件由 or-gen 构建时自动生成。

生成时间: {{ generated_at }}
"""

import json
import logging
import pandas as pd
from pathlib import Path
from typing import Dict, Any, Optional
from nebula3.gclient.net import ConnectionPool
from nebula3.Config import Config

logger = logging.getLogger(__name__)


# 从 or_ontology 提取的 TAG 列表
