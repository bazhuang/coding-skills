# 从 or_ontology 提取的 EDGE 列表
EDGES_CONFIG = [
{% for obj in ontology_objects %}
{% if obj.object_category == "edge" and obj.table_schema %}
    {
        "edge_name": "{{ obj.table_schema.table_name }}",
        "source_table": "{{ obj.table_schema.table_name }}",
{% if obj.edge_endpoints %}
        "src_vid_field": "{{ obj.edge_endpoints.supporting_fields[0] }}",
        "dst_vid_field": "{{ obj.edge_endpoints.supporting_fields[-1] }}",
{% endif %}
        "fields": [
{% for field in obj.table_schema.fields %}
            "{{ field.name }}",
{% endfor %}
        ],
        "field_types": {
{% for field in obj.table_schema.fields %}
            "{{ field.name }}": "{{ field.type | map_to_nebula }}",
{% endfor %}
        },
    },
{% endif %}
{% endfor %}
]


class NebulaImporter:
    """NebulaGraph 数据导入器"""

    def __init__(self, config_path: str):
        """初始化导入器

        Args:
            config_path: nebula_config.json 配置文件路径
        """
        self.config_path = Path(config_path)
        self.config = self._load_config()
        self.connection_pool = None
        self.session = None

    def _load_config(self) -> Dict[str, Any]:
        """加载 NebulaGraph 配置"""
        if not self.config_path.exists():
            raise FileNotFoundError(f"配置文件不存在: {self.config_path}")

        with open(self.config_path, 'r', encoding='utf-8') as fp:
            return json.load(fp)

    def connect(self):
        """连接到 NebulaGraph 集群

        一次性传入所有集群节点地址到 ConnectionPool.init，由连接池内部处理路由和故障转移。
        """
        logger.info("连接到 NebulaGraph...")

        pool_config = Config()
        pool_config.min_connection_pool_size = self.config['pool_config']['min_size']
        pool_config.max_connection_pool_size = self.config['pool_config']['max_size']
        pool_config.idle_time = self.config['pool_config']['idle_time']
        pool_config.timeout = self.config['pool_config']['timeout']
        pool_config.interval_check = self.config['pool_config']['interval_check']

        # 构建集群地址列表
        addresses = [
            (server['host'], server['port'])
            for server in self.config['cluster_servers']
        ]
        logger.info(f"  集群节点: {', '.join([f'{h}:{p}' for h, p in addresses])}")

        # 一次性传入所有节点地址，由连接池内部处理路由
        self.connection_pool = ConnectionPool()
        self.connection_pool.init(addresses, pool_config)

        # 获取会话
        self.session = self.connection_pool.get_session(
            self.config['username'],
            self.config['password']
        )

        # 切换到目标空间
        use_space_sql = f"USE `{self.config['space']}`"
        result = self.session.execute(use_space_sql)
        if not result.is_succeeded():
            raise RuntimeError(f"切换空间失败: {result.error_msg()}")

        logger.info(f"✓ 成功连接到 NebulaGraph")
        logger.info(f"  - 集群节点: {len(addresses)} 个")
        logger.info(f"  - 空间: {self.config['space']}")

    def disconnect(self):
        """断开连接"""
        if self.session:
            self.session.release()
            self.session = None

        if self.connection_pool:
            self.connection_pool.close()
            self.connection_pool = None

        logger.info("✓ 已断开 NebulaGraph 连接")

    def _format_value(self, value: Any, nebula_type: str) -> str:
        """根据 Nebula 类型格式化值

        Args:
            value: 原始值
            nebula_type: Nebula 数据类型

        Returns:
            格式化后的值字符串
        """
        # 处理 NULL 值和序列化后的空时间值
        if pd.isna(value) or value is None:
            return "NULL"

        # JSON 序列化会将 pandas NaT 转为字符串 'NaT'
        if isinstance(value, str) and value.strip().upper() == 'NAT':
            return "NULL"

        # 按类型感知格式化
        if nebula_type == 'bool':
            return 'true' if value else 'false'
        elif nebula_type in ('int', 'int64'):
            try:
                return str(int(value))
            except (ValueError, TypeError):
                return "NULL"
        elif nebula_type == 'double':
            try:
                return str(float(value))
            except (ValueError, TypeError):
                return "NULL"
        elif nebula_type == 'date':
            # date 类型: date('2023-01-01')，取前 10 位
            value_str = str(value)[:10]
            return f"date('{value_str}')"
        elif nebula_type == 'datetime':
            # datetime 类型: datetime('2023-01-01T12:00:00')，空格替换为 T
            value_str = str(value).replace(' ', 'T')
            return f"datetime('{value_str}')"
        elif nebula_type == 'timestamp':
            # timestamp 类型: timestamp('2023-01-01T12:00:00')，空格替换为 T
            value_str = str(value).replace(' ', 'T')
            return f"timestamp('{value_str}')"
        else:
            # 默认按字符串处理，转义单引号和反斜杠
            value_str = str(value).replace("\\", "\\\\").replace("'", "\\'")
            return f"'{value_str}'"

    def import_tag_data(self, tag_name: str, df: pd.DataFrame, mapping: Dict[str, Any], version: Optional[str] = None) -> int:
        """导入 TAG 数据

        Args:
            tag_name: TAG 名称
            df: 数据 DataFrame
            mapping: 字段映射配置
            version: 版本号（可选，如果数据中没有版本字段则必须提供）

        Returns:
            导入的记录数
        """
        logger.info(f"导入 TAG 数据: {tag_name}")
        logger.info(f"  - 读取到 {len(df)} 条记录")

        # 获取 VID 列和字段类型映射
        vid_fields = mapping['vid_fields']
        fields = mapping.get('fields', [])
        field_types = mapping.get('field_types', {})

        # 检查数据中是否有版本过滤字段
        has_version_in_data = '{{{{ version_column }}}}' in df.columns

        if not has_version_in_data and not version:
            raise ValueError(f"TAG {tag_name}: 数据中没有版本字段，且未提供 version 参数")

        # 批量插入
        batch_size = 256
        success_count = 0
        failed_count = 0

        for i in range(0, len(df), batch_size):
            batch = df.iloc[i:i + batch_size]

            # 构建批量插入语句
            insert_statements = []
            for _, row in batch.iterrows():
                # 确定版本号
                if has_version_in_data:
                    row_version = row['{{{{ version_column }}}}']
                else:
                    row_version = version

                # VID = 版本号_vid_field1值_vid_field2值...（vid_fields 已在模板层过滤版本字段）
                vid_parts = [str(row[vf]) for vf in vid_fields if vf in df.columns]
                vid = f"{row_version}_" + '_'.join(vid_parts) if vid_parts else row_version

                # 构建属性名和属性值
                prop_names = []
                prop_values = []

                for field in fields:
                    if field in vid_fields:
                        continue  # 跳过 VID 字段

                    if field not in df.columns:
                        logger.warning(f"  ⚠ 字段 {field} 不在数据中，跳过")
                        continue

                    # 获取字段类型
                    nebula_type = field_types.get(field, 'string')
                    value = row[field]

                    prop_names.append(f"`{field}`")
                    prop_values.append(self._format_value(value, nebula_type))

                # 如果数据中没有版本过滤字段，需要添加
                if not has_version_in_data:
                    prop_names.append("`{{{{ version_column }}}}`")
                    prop_values.append(str(row_version))

                prop_names_str = ", ".join(prop_names)
                prop_values_str = ", ".join(prop_values)
                insert_statements.append(f"INSERT VERTEX `{tag_name}` ({prop_names_str}) VALUES '{vid}':({prop_values_str});")

            # 执行批量插入
            for stmt in insert_statements:
                try:
                    result = self.session.execute(stmt)
                    if result.is_succeeded():
                        success_count += 1
                    else:
                        failed_count += 1
                        logger.warning(f"  ⚠ 插入失败: {result.error_msg()}")
                        logger.debug(f"  SQL: {stmt}")
                except Exception as e:
                    failed_count += 1
                    logger.warning(f"  ⚠ 插入异常: {str(e)}")
                    logger.debug(f"  SQL: {stmt}")

        logger.info(f"  ✓ TAG {tag_name} 导入完成")
        logger.info(f"    - 成功: {success_count} 条")
        logger.info(f"    - 失败: {failed_count} 条")

        return success_count

    def import_edge_data(self, edge_name: str, df: pd.DataFrame, mapping: Dict[str, Any], version: Optional[str] = None) -> int:
        """导入 EDGE 数据

        Args:
            edge_name: EDGE 名称
            df: 数据 DataFrame
            mapping: 字段映射配置
            version: 版本号（可选，如果数据中没有版本字段则必须提供）

        Returns:
            导入的记录数
        """
        logger.info(f"导入 EDGE 数据: {edge_name}")
        logger.info(f"  - 读取到 {len(df)} 条记录")

        # 获取源点、目标点和字段类型映射
        src_vid_field = mapping['src_vid_field']
        dst_vid_field = mapping['dst_vid_field']
        rank_field = mapping.get('rank_field')
        fields = mapping.get('fields', [])
        field_types = mapping.get('field_types', {})

        # 检查数据中是否有版本过滤字段
        has_version_in_data = '{{{{ version_column }}}}' in df.columns

        if not has_version_in_data and not version:
            raise ValueError(f"EDGE {edge_name}: 数据中没有版本字段，且未提供 version 参数")

        # 批量插入
        batch_size = 256
        success_count = 0
        failed_count = 0

        for i in range(0, len(df), batch_size):
            batch = df.iloc[i:i + batch_size]

            # 构建批量插入语句
            insert_statements = []
            for _, row in batch.iterrows():
                # 确定版本号
                if has_version_in_data:
                    row_version = row['{{{{ version_column }}}}']
                else:
                    row_version = version

                # VID = 版本号_vid_field值
                src_vid_value = row[src_vid_field]
                dst_vid_value = row[dst_vid_field]
                src_vid = f"{row_version}_{src_vid_value}"
                dst_vid = f"{row_version}_{dst_vid_value}"

                # 获取 rank 值
                rank_value = 0
                if rank_field and rank_field in df.columns:
                    rank_value = row[rank_field]
                    # 如果 rank 是日期类型，转换为时间戳
                    if pd.api.types.is_datetime64_any_dtype(df[rank_field]):
                        rank_value = int(pd.Timestamp(rank_value).timestamp())
                    else:
                        rank_value = int(rank_value) if not pd.isna(rank_value) else 0

                # 构建属性名和属性值
                prop_names = []
                prop_values = []

                for field in fields:
                    if field in [src_vid_field, dst_vid_field]:
                        continue  # 跳过 VID 字段

                    if field not in df.columns:
                        logger.warning(f"  ⚠ 字段 {field} 不在数据中，跳过")
                        continue

                    # 获取字段类型
                    nebula_type = field_types.get(field, 'string')
                    value = row[field]

                    prop_names.append(f"`{field}`")
                    prop_values.append(self._format_value(value, nebula_type))

                # 如果数据中没有版本过滤字段，需要添加
                if not has_version_in_data:
                    prop_names.append("`{{{{ version_column }}}}`")
                    prop_values.append(str(row_version))

                prop_names_str = ", ".join(prop_names)
                prop_values_str = ", ".join(prop_values)
                insert_statements.append(
                    f"INSERT EDGE `{edge_name}` ({prop_names_str}) VALUES '{src_vid}'->'{dst_vid}'@{rank_value}:({prop_values_str});"
                )

            # 执行批量插入
            for stmt in insert_statements:
                try:
                    result = self.session.execute(stmt)
                    if result.is_succeeded():
                        success_count += 1
                    else:
                        failed_count += 1
                        logger.warning(f"  ⚠ 插入失败: {result.error_msg()}")
                        logger.debug(f"  SQL: {stmt}")
                except Exception as e:
                    failed_count += 1
                    logger.warning(f"  ⚠ 插入异常: {str(e)}")
                    logger.debug(f"  SQL: {stmt}")

        logger.info(f"  ✓ EDGE {edge_name} 导入完成")
        logger.info(f"    - 成功: {success_count} 条")
        logger.info(f"    - 失败: {failed_count} 条")

        return success_count

    def import_all_data(self, table_data: Dict[str, pd.DataFrame], version: Optional[str] = None) -> Dict[str, int]:
        """导入所有数据

        Args:
            table_data: 表名到 DataFrame 的映射
            version: 版本号（可选，如果数据中没有版本字段则必须提供）

        Returns:
            导入统计信息
        """
        results = {}

        # 导入 TAG 数据
        logger.info(f"开始导入 {len(TAGS_CONFIG)} 个 TAG...")
        for tag in TAGS_CONFIG:
            tag_name = tag['tag_name']
            source_table = tag['source_table']

            if source_table not in table_data:
                logger.warning(f"  ⚠ 表 {source_table} 数据不存在，跳过")
                continue

            df = table_data[source_table]
            count = self.import_tag_data(tag_name, df, tag, version)
            results[f"TAG:{tag_name}"] = count

        # 导入 EDGE 数据
        logger.info(f"开始导入 {len(EDGES_CONFIG)} 个 EDGE...")
        for edge in EDGES_CONFIG:
            edge_name = edge['edge_name']
            source_table = edge['source_table']

            if source_table not in table_data:
                logger.warning(f"  ⚠ 表 {source_table} 数据不存在，跳过")
                continue

            df = table_data[source_table]
            count = self.import_edge_data(edge_name, df, edge, version)
            results[f"EDGE:{edge_name}"] = count

        return results


def main():
    """主函数"""
    import argparse

    parser = argparse.ArgumentParser(description='导入数据到 NebulaGraph')
    parser.add_argument('--config', default='{{ nebula_config_path }}', help='NebulaGraph 配置文件路径（默认: {{ nebula_config_path }}）')
    parser.add_argument('--data-dir', default='data', help='数据目录（默认: data）')
    parser.add_argument('--version', help='版本号（可选）')
    parser.add_argument('--log-level', default='INFO',
                        choices=['DEBUG', 'INFO', 'WARNING', 'ERROR'],
                        help='日志级别（默认: INFO）')

    args = parser.parse_args()

    # 配置日志
    logging.basicConfig(
        level=getattr(logging, args.log_level),
        format='%(asctime)s - %(name)s - %(levelname)s - %(message)s'
    )

    importer = None
    try:
        # 创建导入器
        importer = NebulaImporter(args.config)

        # 连接数据库
        importer.connect()

        # 从目录加载数据
        logger.info("=" * 80)
        logger.info("从目录加载数据")
        logger.info("=" * 80)

        data_dir = Path(args.data_dir)
        if not data_dir.exists():
            logger.error(f"数据目录不存在: {data_dir}")
            return 1

        table_data = {}
        for csv_file in data_dir.glob("*.csv"):
            table_name = csv_file.stem
            logger.info(f"加载表: {table_name}")
            df = pd.read_csv(csv_file)
            table_data[table_name] = df

        if not table_data:
            logger.warning("未找到任何 CSV 文件")
            return 0

        logger.info(f"✓ 加载了 {len(table_data)} 个表")

        # 导入数据
        logger.info("=" * 80)
        logger.info("开始导入数据")
        logger.info("=" * 80)

        results = importer.import_all_data(table_data, args.version)

        logger.info("=" * 80)
        logger.info("导入完成")
        logger.info("=" * 80)

        total = sum(results.values())
        logger.info(f"✓ 共导入 {total} 条记录")
        for name, count in results.items():
            logger.info(f"  - {name}: {count} 条")

        return 0

    except Exception as e:
        logger.error(f"导入失败: {str(e)}", exc_info=True)
        return 1

    finally:
        if importer:
            importer.disconnect()


if __name__ == '__main__':
    import sys
    sys.exit(main())
