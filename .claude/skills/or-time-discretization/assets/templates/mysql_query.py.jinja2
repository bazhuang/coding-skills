"""
MySQL 数据查询脚本

根据版本号从 MySQL 仿真表中查询数据。
表列表从 or_ontology 中提取，按 version_id 过滤查询。
此文件由 or-gen 构建时自动生成。

生成时间: {{ generated_at }}
"""

import json
import logging
import pandas as pd
from pathlib import Path
from typing import Dict, Any, Optional, List
from sqlalchemy import create_engine, text
from sqlalchemy.engine import Engine

logger = logging.getLogger(__name__)


# 从 or_ontology 提取的所有表名
ALL_TABLES = [
{% for obj in ontology_objects %}
    {% if obj.table_schema %}
    "{{ obj.table_schema.table_name }}",  # {{ obj.object_category }}: {{ obj.object_name }}
    {% endif %}
{% endfor %}
]


class MySQLQueryExecutor:
    """MySQL 数据查询执行器"""

    def __init__(self, config_path: str):
        """初始化查询执行器

        Args:
            config_path: mysql_config.json 配置文件路径
        """
        self.config_path = Path(config_path)
        self.config = self._load_config()
        self.engine: Optional[Engine] = None

    def _load_config(self) -> Dict[str, Any]:
        """加载 MySQL 配置"""
        if not self.config_path.exists():
            raise FileNotFoundError(f"配置文件不存在: {self.config_path}")

        with open(self.config_path, 'r', encoding='utf-8') as fp:
            return json.load(fp)

    def connect(self):
        """连接到 MySQL 数据库"""
        logger.info("连接到 MySQL 数据库...")

        # 构建连接字符串
        connection_string = (
            f"mysql+pymysql://{self.config['username']}:{self.config['password']}"
            f"@{self.config['host']}:{self.config['port']}/{self.config['database']}"
            f"?charset={self.config['charset']}"
        )

        # 创建引擎
        self.engine = create_engine(
            connection_string,
            pool_size=self.config.get('pool_size', 5),
            pool_recycle=self.config.get('pool_recycle', 3600),
            pool_pre_ping=self.config.get('pool_pre_ping', True),
            connect_args={
                'connect_timeout': self.config.get('connect_timeout', 10)
            }
        )

        # 测试连接
        with self.engine.connect() as conn:
            result = conn.execute(text("SELECT 1"))
            result.fetchone()

        logger.info(f"✓ 成功连接到 MySQL")
        logger.info(f"  - 主机: {self.config['host']}:{self.config['port']}")
        logger.info(f"  - 数据库: {self.config['database']}")

    def disconnect(self):
        """断开连接"""
        if self.engine:
            self.engine.dispose()
            self.engine = None
        logger.info("✓ 已断开 MySQL 连接")

    def query_by_version(self, table_name: str, version: Optional[str] = None) -> pd.DataFrame:
        """根据版本号查询表数据（如果表中没有版本字段，则查询全表）

        Args:
            table_name: 表名
            version: 版本号（可选，如果为 None 则查询全表）

        Returns:
            查询结果的 DataFrame
        """
        if version:
            logger.info(f"查询表 {table_name}，版本号: {version}")
        else:
            logger.info(f"查询表 {table_name}（全表查询）")

        # 检查表中是否有版本过滤字段
        has_version_column = self._check_version_column(table_name)

        # 构建查询 SQL
        if has_version_column and version:
            query = "SELECT * FROM " + table_name + " WHERE `{{ version_column }}` = :version"
            df = pd.read_sql(text(query), self.engine, params={"version": version})
        else:
            # 如果没有版本字段或未指定版本号，查询全表
            if has_version_column and not version:
                logger.warning(f"  ⚠ 表 {table_name} 有版本字段但未指定版本号，将查询全表")
            elif not has_version_column and version:
                logger.warning(f"  ⚠ 表 {table_name} 没有版本字段，忽略版本号参数，查询全表")

            query = f"SELECT * FROM {table_name}"
            df = pd.read_sql(text(query), self.engine)

        logger.info(f"  ✓ 查询到 {len(df)} 条记录")

        return df

    def _check_version_column(self, table_name: str) -> bool:
        """检查表中是否存在版本过滤字段

        Args:
            table_name: 表名

        Returns:
            是否存在版本过滤字段
        """
        try:
            query = f"""
                SELECT COUNT(*) as count
                FROM information_schema.COLUMNS
                WHERE TABLE_SCHEMA = :database
                AND TABLE_NAME = :table_name
                AND COLUMN_NAME = '{{ version_column }}'
            """
            result = pd.read_sql(
                text(query),
                self.engine,
                params={
                    "database": self.config['database'],
                    "table_name": table_name
                }
            )
            return result['count'].iloc[0] > 0
        except Exception as e:
            logger.warning(f"  ⚠ 检查版本字段失败: {str(e)}，假设字段不存在")
            return False

    def query_all_tables(self, version: Optional[str] = None) -> Dict[str, pd.DataFrame]:
        """查询所有配置的表数据

        Args:
            version: 版本号（可选，如果为 None 则查询全表）

        Returns:
            表名到 DataFrame 的映射
        """
        tables = ALL_TABLES

        if version:
            logger.info(f"开始查询 {len(tables)} 个表的数据（版本号: {version}）...")
        else:
            logger.info(f"开始查询 {len(tables)} 个表的数据（全表查询）...")

        results = {}
        for table in tables:
            try:
                df = self.query_by_version(table, version)
                results[table] = df
            except Exception as e:
                logger.error(f"  ✗ 查询表 {table} 失败: {str(e)}")
                raise

        logger.info(f"✓ 所有表查询完成")
        return results


def main():
    """主函数"""
    import argparse

    parser = argparse.ArgumentParser(description='从 MySQL 查询仿真表数据')
    parser.add_argument('--config', default='{{ mysql_config_path }}', help='MySQL 配置文件路径（默认: {{ mysql_config_path }}）')
    parser.add_argument('--version', help='版本号（可选，不指定则查询全表）')
    parser.add_argument('--output', default='data', help='输出目录（默认: data）')
    parser.add_argument('--table', help='指定表名（可选，不指定则查询所有表）')
    parser.add_argument('--log-level', default='INFO',
                        choices=['DEBUG', 'INFO', 'WARNING', 'ERROR'],
                        help='日志级别（默认: INFO）')

    args = parser.parse_args()

    # 配置日志
    logging.basicConfig(
        level=getattr(logging, args.log_level),
        format='%(asctime)s - %(name)s - %(levelname)s - %(message)s'
    )

    executor = None
    try:
        # 创建执行器
        executor = MySQLQueryExecutor(args.config)

        # 连接数据库
        executor.connect()

        # 查询数据
        logger.info("=" * 80)
        logger.info("开始查询数据")
        logger.info("=" * 80)

        if args.table:
            # 查询单个表
            df = executor.query_by_version(args.table, args.version)

            # 保存到文件
            output_dir = Path(args.output)
            output_dir.mkdir(parents=True, exist_ok=True)

            if args.version:
                output_file = output_dir / f"{args.table}_v{args.version}.csv"
            else:
                output_file = output_dir / f"{args.table}.csv"

            df.to_csv(output_file, index=False, encoding='utf-8')
            logger.info(f"✓ 数据已保存到: {output_file}")
        else:
            # 查询所有表
            results = executor.query_all_tables(args.version)

            # 保存到文件
            output_dir = Path(args.output)
            output_dir.mkdir(parents=True, exist_ok=True)

            logger.info(f"✓ 共查询 {len(results)} 个表")
            for table, df in results.items():
                if args.version:
                    output_file = output_dir / f"{table}_v{args.version}.csv"
                else:
                    output_file = output_dir / f"{table}.csv"

                df.to_csv(output_file, index=False, encoding='utf-8')
                logger.info(f"  - {table}: {len(df)} 条记录 -> {output_file}")

        logger.info("=" * 80)
        logger.info("查询完成")
        logger.info("=" * 80)

        return 0

    except Exception as e:
        logger.error(f"查询失败: {str(e)}", exc_info=True)
        return 1

    finally:
        if executor:
            executor.disconnect()


if __name__ == '__main__':
    import sys
    sys.exit(main())
