"""
数据管道编排脚本

编排三个步骤：
1. 从 MySQL 查询仿真表数据（表列表从 or_ontology 提取）
2. 将数据导入到 NebulaGraph（TAG/EDGE 列表从 or_ontology 提取）
3. 从 NebulaGraph 查询数据并按时间拆分（拆分规则从 time_discretization_config 读取）

此文件由 or-gen 构建时自动生成。

生成时间: {{ generated_at }}
"""

import json
import logging
import sys
from pathlib import Path
from typing import Dict, Any

logger = logging.getLogger(__name__)


class DataPipeline:
    """数据管道编排器"""

    def __init__(
        self,
        mysql_config_path: str,
        nebula_config_path: str,
        time_config_path: str
    ):
        """初始化数据管道

        Args:
            mysql_config_path: MySQL 配置文件路径
            nebula_config_path: NebulaGraph 配置文件路径
            time_config_path: time_discretization_config.json 配置文件路径
        """
        self.mysql_config_path = mysql_config_path
        self.nebula_config_path = nebula_config_path
        self.time_config_path = time_config_path

        # 存储查询结果和版本号
        self.table_data = None
        self.current_version = None

    def run(self, version: str) -> Dict[str, Any]:
        """运行数据管道

        Args:
            version: 数据版本号

        Returns:
            执行结果统计
        """
        logger.info("=" * 80)
        logger.info("数据管道开始执行")
        logger.info("=" * 80)
        logger.info(f"版本号: {version}")

        # 保存版本号
        self.current_version = version
        results = {}

        # Step 1: 从 MySQL 查询数据
        logger.info("\n" + "=" * 80)
        logger.info("Step 1: 从 MySQL 查询数据")
        logger.info("=" * 80)

        try:
            query_results = self._step1_query_mysql(version)
            self.table_data = query_results
            results['step1_query'] = {
                'status': 'success',
                'tables': list(query_results.keys())
            }
            logger.info(f"✓ Step 1 完成，查询了 {len(query_results)} 个表")
        except Exception as e:
            logger.error(f"✗ Step 1 失败: {str(e)}", exc_info=True)
            results['step1_query'] = {
                'status': 'failed',
                'error': str(e)
            }
            return results

        # Step 2: 导入数据到 NebulaGraph
        logger.info("\n" + "=" * 80)
        logger.info("Step 2: 导入数据到 NebulaGraph")
        logger.info("=" * 80)

        try:
            import_results = self._step2_import_nebula(version)
            results['step2_import'] = {
                'status': 'success',
                'records': import_results
            }
            total_records = sum(import_results.values())
            logger.info(f"✓ Step 2 完成，导入了 {total_records} 条记录")
        except Exception as e:
            logger.error(f"✗ Step 2 失败: {str(e)}", exc_info=True)
            results['step2_import'] = {
                'status': 'failed',
                'error': str(e)
            }
            return results

        # Step 3: 数据拆分
        logger.info("\n" + "=" * 80)
        logger.info("Step 3: 按时间维度拆分数据")
        logger.info("=" * 80)

        try:
            split_results = self._step3_split_data()
            results['step3_split'] = {
                'status': 'success',
                'splits': split_results
            }
            logger.info(f"✓ Step 3 完成，拆分了 {len(split_results)} 个实体")
        except Exception as e:
            logger.error(f"✗ Step 3 失败: {str(e)}", exc_info=True)
            results['step3_split'] = {
                'status': 'failed',
                'error': str(e)
            }
            return results

        logger.info("\n" + "=" * 80)
        logger.info("数据管道执行完成")
        logger.info("=" * 80)

        return results

    def _step1_query_mysql(self, version: str) -> Dict[str, Any]:
        """Step 1: 从 MySQL 查询数据

        Args:
            version: 版本号

        Returns:
            表名到 DataFrame 的映射
        """
        # 动态导入 mysql_query 模块
        import importlib.util

        script_path = Path(__file__).parent / "mysql_query.py"
        spec = importlib.util.spec_from_file_location("mysql_query", script_path)
        mysql_query = importlib.util.module_from_spec(spec)
        sys.modules["mysql_query"] = mysql_query
        spec.loader.exec_module(mysql_query)

        # 创建执行器
        executor = mysql_query.MySQLQueryExecutor(self.mysql_config_path)

        try:
            # 连接数据库
            executor.connect()

            # 查询所有表
            results = executor.query_all_tables(version)

            return results

        finally:
            executor.disconnect()

    def _step2_import_nebula(self, version: str) -> Dict[str, int]:
        """Step 2: 导入数据到 NebulaGraph

        Args:
            version: 版本号

        Returns:
            导入统计信息
        """
        # 动态导入 nebula_import 模块
        import importlib.util

        script_path = Path(__file__).parent / "nebula_import.py"
        spec = importlib.util.spec_from_file_location("nebula_import", script_path)
        nebula_import = importlib.util.module_from_spec(spec)
        sys.modules["nebula_import"] = nebula_import
        spec.loader.exec_module(nebula_import)

        # 创建导入器
        importer = nebula_import.NebulaImporter(self.nebula_config_path)

        try:
            # 连接数据库
            importer.connect()

            # 导入所有数据（不再需要 data_mapping_path）
            results = importer.import_all_data(
                self.table_data,
                version
            )

            return results

        finally:
            importer.disconnect()

    def _step3_split_data(self) -> Dict[str, Any]:
        """Step 3: 数据拆分

        使用 time_discretization_config.json 作为拆分规则来源。

        Returns:
            拆分统计信息
        """
        # 动态导入 data_split 模块
        import importlib.util

        script_path = Path(__file__).parent / "data_split.py"
        spec = importlib.util.spec_from_file_location("data_split", script_path)
        data_split = importlib.util.module_from_spec(spec)
        sys.modules["data_split"] = data_split
        spec.loader.exec_module(data_split)

        # 创建拆分器，使用 time_config_path 替代 data_mapping_path
        splitter = data_split.DataSplitter(
            self.nebula_config_path,
            self.time_config_path,
            self.current_version,
            self.mysql_config_path  # 拆分结果写回 MySQL
        )

        try:
            # 连接数据库
            splitter.connect()

            # 处理拆分
            results = splitter.process_all_splits()

            return results

        finally:
            splitter.disconnect()


def main():
    """主函数"""
    import argparse

    parser = argparse.ArgumentParser(description='数据管道编排')
    parser.add_argument('--version', help='数据版本号（可选）')
    parser.add_argument('--mysql-config', default='{{ mysql_config_path }}',
                        help='MySQL 配置文件路径（默认: {{ mysql_config_path }}）')
    parser.add_argument('--nebula-config', default='{{ nebula_config_path }}',
                        help='NebulaGraph 配置文件路径（默认: {{ nebula_config_path }}）')
    parser.add_argument('--time-config', default='{{ time_config_path }}',
                        help='时间拆分配置文件路径（默认: {{ time_config_path }}）')
    parser.add_argument('--log-level', default='INFO',
                        choices=['DEBUG', 'INFO', 'WARNING', 'ERROR'],
                        help='日志级别（默认: INFO）')

    args = parser.parse_args()

    # 配置日志
    logging.basicConfig(
        level=getattr(logging, args.log_level),
        format='%(asctime)s - %(name)s - %(levelname)s - %(message)s'
    )

    try:
        # 创建管道
        pipeline = DataPipeline(
            mysql_config_path=args.mysql_config,
            nebula_config_path=args.nebula_config,
            time_config_path=args.time_config
        )

        # 运行管道
        results = pipeline.run(args.version)

        # 输出结果摘要
        logger.info("\n" + "=" * 80)
        logger.info("执行结果摘要")
        logger.info("=" * 80)

        for step, result in results.items():
            status = result['status']
            status_symbol = "✓" if status == 'success' else "✗"
            logger.info(f"{status_symbol} {step}: {status}")

            if status == 'failed':
                logger.error(f"  错误: {result.get('error', 'Unknown error')}")

        # 检查是否所有步骤都成功
        all_success = all(r['status'] == 'success' for r in results.values())

        if all_success:
            logger.info("\n✓ 数据管道执行成功")
            return 0
        else:
            logger.error("\n✗ 数据管道执行失败")
            return 1

    except Exception as e:
        logger.error(f"数据管道执行异常: {str(e)}", exc_info=True)
        return 1


if __name__ == '__main__':
    sys.exit(main())
