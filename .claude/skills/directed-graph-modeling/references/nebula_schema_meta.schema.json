{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nebula_schema_meta.schema.json",
  "title": "NebulaGraph Schema Metadata",
  "description": "NebulaGraph 图数据库结构化中间态，经校验后用于渲染 DDL SQL 和 DDL 执行代码",
  "type": "object",
  "additionalProperties": false,
  "required": ["tags", "edges"],
  "properties": {
    "space_name": {
      "type": "string",
      "description": "图空间名，来源于 NebulaGraph 配置的 space 字段",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "description": "TAG 节点定义列表",
      "minItems": 1,
      "items": { "$ref": "#/$defs/tag" }
    },
    "edges": {
      "type": "array",
      "description": "EDGE 边定义列表",
      "minItems": 0,
      "items": { "$ref": "#/$defs/edge" }
    }
  },
  "$defs": {
    "tag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "tag_type", "vid_field", "source_table", "fields", "field_types"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "TAG 名称，必须与 table_schema.table_name 完全一致",
          "minLength": 1
        },
        "tag_type": {
          "type": "string",
          "enum": ["supply_node", "demand_node", "passthrough_node", "processor_node", "storage_node"],
          "description": "节点类型"
        },
        "vid_field": {
          "type": "string",
          "description": "VID 字段名，来源于唯一索引或 primary_key[0]"
        },
        "source_table": {
          "type": "string",
          "description": "源表名，与 name 一致"
        },
        "fields": {
          "type": "array",
          "description": "属性字段列表，必须包含 version_id",
          "items": { "type": "string" }
        },
        "field_types": {
          "type": "object",
          "description": "字段名到 NebulaGraph 类型的映射，必须覆盖 fields 中的所有字段",
          "additionalProperties": { "type": "string" }
        },
        "indexes": {
          "type": "array",
          "description": "索引字段列表，必须包含 version_id",
          "items": { "type": "string" }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "edge_type", "src_tag", "dst_tag", "src_vid_field", "dst_vid_field",
        "source_table", "fields", "field_types"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "EDGE 名称，必须与 table_schema.table_name 完全一致",
          "minLength": 1
        },
        "edge_type": {
          "type": "string",
          "enum": ["transport", "link"],
          "description": "边类型"
        },
        "src_tag": {
          "type": "string",
          "description": "源节点 TAG 名称，必须存在于 tags 列表中"
        },
        "dst_tag": {
          "type": "string",
          "description": "目标节点 TAG 名称，必须存在于 tags 列表中"
        },
        "src_vid_field": {
          "type": "string",
          "description": "源节点 VID 字段名，必须存在于 fields 列表中"
        },
        "dst_vid_field": {
          "type": "string",
          "description": "目标节点 VID 字段名，必须存在于 fields 列表中"
        },
        "rank_field": {
          "type": "string",
          "description": "排序字段，来源于 primary_key[0]，可为 null"
        },
        "source_table": {
          "type": "string",
          "description": "源表名，与 name 一致"
        },
        "fields": {
          "type": "array",
          "description": "属性字段列表，必须包含 version_id",
          "items": { "type": "string" }
        },
        "field_types": {
          "type": "object",
          "description": "字段名到 NebulaGraph 类型的映射，必须覆盖 fields 中的所有字段",
          "additionalProperties": { "type": "string" }
        },
        "indexes": {
          "type": "array",
          "description": "索引字段列表，必须包含 version_id",
          "items": { "type": "string" }
        }
      }
    }
  }
}
